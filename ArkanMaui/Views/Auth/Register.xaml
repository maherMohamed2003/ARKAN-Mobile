<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ArkanMaui.Views.Auth.RegisterPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#2B2B2D"
    FlowDirection="LeftToRight">

    <ContentPage.Resources>

        <Color x:Key="ArkanRequired">#E53935</Color>
        <Color x:Key="ArkanWine">#6B1F38</Color>
        <Color x:Key="ArkanSoft">#D9D2C5</Color>
        <Color x:Key="ArkanUploadFill">#3A3A3A</Color>
        <Color x:Key="ArkanUploadStroke">#C5A15B</Color>

        <Style x:Key="FormLabel"
               TargetType="Label"
               BasedOn="{StaticResource ArkanFieldLabel}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="HorizontalTextAlignment" Value="Start" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <Style x:Key="FormBorder"
               TargetType="Border"
               BasedOn="{StaticResource ArkanEntryBorder}">
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <Style x:Key="FormEntry" TargetType="Entry">
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="PlaceholderColor"
                    Value="{StaticResource ArkanPlaceholder}" />
            <Setter Property="TextColor"
                    Value="{StaticResource ArkanLight}" />
            <Setter Property="FontFamily" Value="JakartaRegular" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalTextAlignment" Value="Start" />
        </Style>

        <Style x:Key="FormIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="16" />
            <Setter Property="HeightRequest" Value="16" />
            <Setter Property="Aspect" Value="AspectFit" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

    </ContentPage.Resources>

    <Grid x:Name="RootGrid" BackgroundColor="#2B2B2D">

        <!-- BACKGROUND (full screen) -->

        <Image Source="bg.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />


        <!-- MAIN CONTENT -->

        <ScrollView VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                x:Name="FormStack"
                Spacing="3"
                Padding="20,4,20,24"
                VerticalOptions="Start">

                <!-- LOGO -->

                <Image
                    Source="logo.png"
                    HeightRequest="50"
                    Aspect="AspectFit"
                    HorizontalOptions="Center" />

                <!-- REGISTER TITLE -->

                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label 
                        Text="REGISTER"
                        FontFamily="CinzelRegular"
                        FontSize="25"
                        TextColor="#F3EBDD"
                        HorizontalOptions="Center" />
                    
                    
                    <BoxView 
                        HeightRequest="1.5"
                        WidthRequest="85"
                        Color="#C9A55C"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>  

                <!-- FIRST NAME & LAST NAME -->

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <VerticalStackLayout Grid.Column="0" Spacing="3">

                        <Label Style="{StaticResource FormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="First Name" />
                                    <Span Text=" *"
                                          TextColor="{StaticResource ArkanRequired}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Border Style="{StaticResource FormBorder}">
                            <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                <Image Source="person.png"
                                       Style="{StaticResource FormIcon}" />

                                <Entry Grid.Column="1"
                                       Placeholder="First Name"
                                       Style="{StaticResource FormEntry}" 
                                       x:Name="FirstName"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">

                        <Label Style="{StaticResource FormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Last Name" />
                                    <Span Text=" *"
                                          TextColor="{StaticResource ArkanRequired}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Border Style="{StaticResource FormBorder}">
                            <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                <Image Source="person.png"
                                       Style="{StaticResource FormIcon}" />

                                <Entry Grid.Column="1"
                                       Placeholder="Last Name"
                                       Style="{StaticResource FormEntry}"
                                       x:Name="LastName"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>

                </Grid>

                <!-- EMAIL & PHONE -->

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <VerticalStackLayout Grid.Column="0" Spacing="2">

                        <Label Style="{StaticResource FormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Email" />
                                    <Span Text=" *"
                                          TextColor="{StaticResource ArkanRequired}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Border Style="{StaticResource FormBorder}">
                            <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                <Image Source="icon_email.png"
                                       Style="{StaticResource FormIcon}" />

                                <Entry Grid.Column="1"
                                       Placeholder="name@example.com"
                                       Keyboard="Email"
                                       Style="{StaticResource FormEntry}"
                                       FontSize="11"
                                       x:Name="Email"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">

                        <Label Style="{StaticResource FormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Phone" />
                                    <Span Text=" *"
                                          TextColor="{StaticResource ArkanRequired}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Border Style="{StaticResource FormBorder}">
                            <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                <Image Source="icon_phone.png"
                                       Style="{StaticResource FormIcon}" />

                                <Entry Grid.Column="1"
                                       Placeholder="+20 1X XXX XXXX"
                                       Keyboard="Telephone"
                                       Style="{StaticResource FormEntry}"
                                       FontSize="11"
                                       x:Name="Phone"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>

                </Grid>

                <!-- PASSWORD -->

                <VerticalStackLayout Spacing="2">

                    <Label Style="{StaticResource FormLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Password" />
                                <Span Text=" *"
                                      TextColor="{StaticResource ArkanRequired}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Border Style="{StaticResource FormBorder}">
                        <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                            <Image Source="passlock.png"
                                   Style="{StaticResource FormIcon}" />

                            <Entry Grid.Column="1"
                                   Placeholder="Create Your Password"
                                   IsPassword="True"
                                   Style="{StaticResource FormEntry}"
                                   x:Name="Password1"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- CONFIRM PASSWORD -->

                <VerticalStackLayout Spacing="2">

                    <Label Style="{StaticResource FormLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Confirm Password" />
                                <Span Text=" *"
                                      TextColor="{StaticResource ArkanRequired}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Border Style="{StaticResource FormBorder}">
                        <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                            <Image Source="passlock.png"
                                   Style="{StaticResource FormIcon}" />

                            <Entry Grid.Column="1"
                                   Placeholder="Confirm Your Password"
                                   IsPassword="True"
                                   Style="{StaticResource FormEntry}"
                                   x:Name="Password2"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- PROFILE IMAGE UPLOAD -->

                <VerticalStackLayout Spacing="2">

                    <Label Style="{StaticResource FormLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Profile Image " />
                                <Span Text="(Optional)"
                                      TextColor="{StaticResource ArkanSecondary}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Border
                        BackgroundColor="{StaticResource ArkanUploadFill}"
                        Stroke="{StaticResource ArkanUploadStroke}"
                        StrokeThickness="1"
                        StrokeDashArray="2,2"
                        StrokeShape="RoundRectangle 10"
                        MinimumHeightRequest="48"
                        Padding="8,4">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8"
                            VerticalOptions="Center">

                            <Grid Grid.Column="0"
                                  WidthRequest="34"
                                  HeightRequest="34"
                                  VerticalOptions="Center">
                                <Image
                                    x:Name="UploadIcon"
                                    Source="icon_upload.png"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <Image
                                    x:Name="ProfileImagePreview"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    Aspect="AspectFill"
                                    IsVisible="False"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">

                                <Label
                                    x:Name="UploadStatusLabel"
                                    Text="Drag &amp; Drop or"
                                    TextColor="{StaticResource ArkanSoft}"
                                    FontFamily="JakartaMedium"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="UploadHintLabel"
                                    Text="JPG,PNG up to 5 MB"
                                    TextColor="{StaticResource ArkanPlaceholder}"
                                    FontFamily="JakartaRegular"
                                    FontSize="9"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Text="Upload"
                                TextColor="#000000"
                                FontFamily="ZenAntique"
                                FontSize="12"
                                FontAttributes="Bold"
                                WidthRequest="70"
                                HeightRequest="30"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                Padding="0"
                                CornerRadius="15"
                                BorderColor="#C5A15B"
                                BorderWidth="1"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                Clicked="OnUploadImageClicked">

                                <Button.Background>
                                    <LinearGradientBrush
                                        StartPoint="0,0.5"
                                        EndPoint="1,0.5">
                                        <GradientStop Color="#C5A15B" Offset="0.0" />
                                        <GradientStop Color="#FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#C5A15B" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Button.Background>

                            </Button>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

                <!-- TERMS & CONDITIONS -->

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="2"
                    HorizontalOptions="Fill">

                    
                    <Grid Grid.Column="0"
                          WidthRequest="28"
                          HeightRequest="28"
                          VerticalOptions="Center">
                        <Border WidthRequest="18"
                                HeightRequest="18"
                                StrokeShape="RoundRectangle 4"
                                Stroke="{StaticResource ArkanSecondary}"
                                StrokeThickness="1.2"
                                BackgroundColor="{StaticResource ArkanUploadFill}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                InputTransparent="True" />
                        <Path Data="M1,5 L4.5,8.5 L11,1"
                              Stroke="{StaticResource ArkanSecondary}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              Aspect="Uniform"
                              WidthRequest="11"
                              HeightRequest="9"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True"
                              IsVisible="{Binding IsChecked, Source={x:Reference TermsCheck}}" />
                        <CheckBox x:Name="TermsCheck"
                                  Opacity="0" />
                    </Grid>


                    <Label
                        Grid.Column="1"
                        FontFamily="JakartaRegular"
                        FontSize="11"
                        TextColor="{StaticResource ArkanSoft}"
                        HorizontalTextAlignment="Start"
                        VerticalOptions="Center">

                        <Label.FormattedText>
                            <FormattedString>
                                <Span 
                                    Text="I agree to the " 
                                    TextColor="{StaticResource ArkanSoft}" />
                                <Span
                                    Text="Terms &amp; Conditions "
                                    TextColor="{StaticResource ArkanSecondary}"
                                    TextDecorations="Underline" />
                                <Span
                                    Text="and &#x0a;         "
                                    TextColor="{StaticResource ArkanSoft}" />
                                <Span
                                    Text="Privacy Policy"
                                    TextColor="{StaticResource ArkanSecondary}"
                                    TextDecorations="Underline" />

                            </FormattedString>
                        </Label.FormattedText>
                        </Label>

                </Grid>

                <!-- REGISTER BUTTON -->

                <Button
                    Text="REGISTER"
                    FontFamily="PlusJakartaSans"
                    Style="{StaticResource ArkanPrimaryButton}"
                    BackgroundColor="{StaticResource ArkanWine}"
                    TextColor="{StaticResource ArkanLight}"
                    BorderColor="{StaticResource ArkanSecondary}"
                    BorderWidth="1"
                    CornerRadius="20"
                    HeightRequest="40"
                    MinimumHeightRequest="0"
                    Padding="0"
                    FontSize="14"
                    Clicked="RegisterBTN"/>

                <!-- OR DIVIDER -->

                <HorizontalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <BoxView
                        WidthRequest="36"
                        HeightRequest="1"
                        Color="{StaticResource ArkanSecondary}"
                        VerticalOptions="Center" />

                    <Label
                        Text="or"
                        TextColor="{StaticResource ArkanSoft}"
                        FontFamily="JakartaRegular"
                        FontSize="11" />

                    <BoxView
                        WidthRequest="36"
                        HeightRequest="1"
                        Color="{StaticResource ArkanSecondary}"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

                <!-- LOGIN NAVIGATION -->

                <Label
                    Text="Already have an account ?"
                    TextColor="{StaticResource ArkanSecondary}"
                    TextDecorations="Underline"
                    FontFamily="JakartaRegular"
                    FontSize="11"
                    HorizontalOptions="Center" />

                <Label
                    Text="Sign In"
                    FontSize="14"
                    TextColor="#C5A15B"
                    HorizontalOptions="Center"
                    Padding="0,2">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                    </Label.GestureRecognizers>

                </Label>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
