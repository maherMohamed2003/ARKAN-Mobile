<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#2B2B2D"
             FlowDirection="LeftToRight"
             x:Class="ArkanMaui.Views.Auth.RestoreAccount"
             Title="restore account">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Gold">#C9A55C</Color>
            <Color x:Key="Maroon">#6B1F37</Color>
            <Color x:Key="FieldBg">#26FFFFFF</Color>

            <x:String x:Key="TitleFont">CormorantRegular</x:String>
            <x:String x:Key="BodyFont">OutfitRegular</x:String>

            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource Gold}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="BackgroundColor" Value="{StaticResource FieldBg}" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>

            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="PlaceholderColor" Value="#9A9A9A" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#2B2B2D">

        <!-- BACKGROUND (full screen) -->
        <Image Source="bg.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />


        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,6,24,24" Spacing="6">

                
                <Image Source="logo1.png"
                       HeightRequest="50"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="RESTORE ACCOUNT"
                           FontFamily="CinzelRegular"
                           FontSize="28"
                           TextColor="#F3EBDD"
                           HorizontalOptions="Center" />
                    <BoxView HeightRequest="1.5"
                             WidthRequest="85"
                             Color="{StaticResource Gold}"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- DESCRIPTION -->
                <Label Text="Enter your email here that belongs to &#10;        your account."
                       FontFamily="{StaticResource BodyFont}"
                       FontSize="13"
                       TextColor="{StaticResource Gold}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       Margin="0,10,0,6" />

                <!-- EMAIL -->
                <VerticalStackLayout Spacing="3" Margin="0,8,0,0">
                    <Label 
                        Style="{StaticResource FieldLabel}" 
                        FontFamily="{StaticResource BodyFont}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Email" />
                                <Span Text="*" TextColor="Red" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Border 
                        BackgroundColor="#2B2D2E" 
                        Style="{StaticResource FieldBorder}">
                        <Grid 
                            ColumnDefinitions="22,*" 
                            ColumnSpacing="6">
                            <Image 
                                Source="icon_email.png" 
                                WidthRequest="18" 
                                HeightRequest="18" 
                                VerticalOptions="Center" /> 
                            <Entry 
                                x:Name="EmailEntry"
                                Grid.Column="1"
                                Placeholder="Enter your email"
                                Keyboard="Email"
                                Style="{StaticResource FieldEntry}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- CONTINUE BUTTON -->
                <Button Text="CONTINUE"
                        FontFamily="PlusJakartaSans"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        BackgroundColor="{StaticResource Maroon}"
                        BorderColor="{StaticResource Gold}"
                        BorderWidth="1"
                        CornerRadius="21"
                        HeightRequest="42"
                        MinimumHeightRequest="0"
                        Padding="0"
                        Margin="0,8,0,0"
                        Clicked="OnContinueClicked" />

                <!-- BACK -->
                <HorizontalStackLayout 
                    HorizontalOptions="Center"
                    Spacing="6"
                    Margin="0,6,0,0"
                    Padding="0,4">
                    
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    
                    <Label 
                        Text="←"
                        FontSize="14"
                        TextColor="White"
                        VerticalOptions="Center" />
                    
                    <Label 
                        Text="Back"
                        FontFamily="PlusJakartaSans"
                        FontSize="14"
                        TextColor="{StaticResource Gold}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
