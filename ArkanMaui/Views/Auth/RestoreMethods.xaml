<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#2B2B2D"
             FlowDirection="LeftToRight"
             x:Class="ArkanMaui.Views.Auth.RestoreMethods"
             Title="forget password">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Gold">#C9A55C</Color>
            <Color x:Key="Maroon">#6B1F37</Color>

            <x:String x:Key="TitleFont">CormorantRegular</x:String>
            <x:String x:Key="BodyFont">OutfitRegular</x:String>

            <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#C5A15B" Offset="0.0" />
                <GradientStop Color="#FFFFFF" Offset="0.5" />
                <GradientStop Color="#C5A15B" Offset="1.0" />
            </LinearGradientBrush>

            <Style x:Key="MethodCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Stroke" Value="{StaticResource GoldGradient}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="#3A3A3A" />
                <Setter Property="HeightRequest" Value="86" />
                <Setter Property="Padding" Value="18,0" />
                <Style.Triggers>
                    
                    <!-- الكارت المحدد: شادو بسيط حواليه -->
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsSelected}"
                                 Value="True">
                        <Setter Property="Shadow">
                            <Setter.Value>
                                <Shadow Brush="#F0DDA8"
                                        Offset="0,0"
                                        Radius="12"
                                        Opacity="0.35" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MethodName" TargetType="Label">
                <Setter Property="FontFamily" Value="OutfitRegular" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="MethodTarget" TargetType="Label">
                <Setter Property="FontFamily" Value="OutfitRegular" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="#9A9A9A" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#2B2B2D">

        <!-- BACKGROUND (full screen) -->
        <Image Source="bg.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,6,24,24" Spacing="6">

                <!-- LOGO  -->
                <Image Source="logo1.png"
                       HeightRequest="50"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />
                

                
                <VerticalStackLayout 
                    Spacing="2" 
                    HorizontalOptions="Center">
                    
                    <Label 
                        Text="CHOOSE RESTORE METHOD"
                        FontFamily="CinzelRegular"
                        FontSize="22"
                        TextColor="#F3EBDD"
                        HorizontalOptions="Center" />
                    
                    <BoxView 
                        HeightRequest="1.5"
                        WidthRequest="85"
                        Color="{StaticResource Gold}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
                

                <!-- DESCRIPTION -->
                <Label Text="Choose how you want to receive your&#10;     reset code"
                       FontFamily="PlusJakartaSans"
                       FontSize="13"
                       TextColor="{StaticResource Gold}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       Margin="0,12,0,8" />

                <!-- METHODS -->
                <VerticalStackLayout Spacing="14" Margin="6,6">

                    <!-- ========== EMAIL (Gmail) ========== -->
                    <Border x:Name="GmailCard" Style="{StaticResource MethodCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMethodTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Image Grid.Column="0"
                                   Source="icon_email.png"
                                   WidthRequest="46"
                                   HeightRequest="46"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Email" Style="{StaticResource MethodName}" />
                                <Label Text="{Binding Target}" Style="{StaticResource MethodTarget}" />
                            </VerticalStackLayout>

                            <!-- RADIO: حدود تدرج + نقطة تدرج -->
                            <Grid Grid.Column="2" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                                <Border StrokeShape="Ellipse"
                                        Stroke="{StaticResource GoldGradient}"
                                        StrokeThickness="1.5"
                                        BackgroundColor="#3A3A3A"
                                        InputTransparent="True" />
                                <Ellipse Fill="{StaticResource GoldGradient}"
                                         WidthRequest="14"
                                         HeightRequest="14"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         InputTransparent="True"
                                         IsVisible="{Binding IsSelected}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ========== WHATSAPP ========== -->
                    <Border x:Name="WhatsappCard" Style="{StaticResource MethodCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMethodTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Image Grid.Column="0"
                                   Source="method_whatsapp.png"
                                   WidthRequest="46"
                                   HeightRequest="46"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="WhatsApp" Style="{StaticResource MethodName}" />
                                <Label Text="{Binding Target}" Style="{StaticResource MethodTarget}" />
                            </VerticalStackLayout>

                            <!-- RADIO -->
                            <Grid Grid.Column="2" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                                <Border StrokeShape="Ellipse"
                                        Stroke="{StaticResource GoldGradient}"
                                        StrokeThickness="1.5"
                                        BackgroundColor="#3A3A3A"
                                        InputTransparent="True" />
                                <Ellipse Fill="{StaticResource GoldGradient}"
                                         WidthRequest="14"
                                         HeightRequest="14"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         InputTransparent="True"
                                         IsVisible="{Binding IsSelected}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ========== TELEGRAM (بيظهر بس لو الـ API رجّعه) ========== -->
                    <Border x:Name="TelegramCard" Style="{StaticResource MethodCard}" IsVisible="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMethodTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Image Grid.Column="0"
                                   Source="method_telegram.png"
                                   WidthRequest="46"
                                   HeightRequest="46"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Telegram" Style="{StaticResource MethodName}" />
                                <Label Text="{Binding Target}" Style="{StaticResource MethodTarget}" />
                            </VerticalStackLayout>

                            <!-- RADIO -->
                            <Grid Grid.Column="2" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                                <Border StrokeShape="Ellipse"
                                        Stroke="{StaticResource GoldGradient}"
                                        StrokeThickness="1.5"
                                        BackgroundColor="#3A3A3A"
                                        InputTransparent="True" />
                                <Ellipse Fill="{StaticResource GoldGradient}"
                                         WidthRequest="14"
                                         HeightRequest="14"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         InputTransparent="True"
                                         IsVisible="{Binding IsSelected}" />
                            </Grid>
                        </Grid>
                    </Border>

                </VerticalStackLayout>


                <!-- BUTTON -->
                <Button Text="CONTINUE"
                        FontFamily="PlusJakartaSans"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        BackgroundColor="{StaticResource Maroon}"
                        BorderColor="{StaticResource Gold}"
                        BorderWidth="1"
                        CornerRadius="21"
                        HeightRequest="42"
                        MinimumHeightRequest="0"
                        Padding="0"
                        Margin="0,10,0,0"
                        Clicked="OnResetClicked" />

                <!-- REMEMBER PASSWORD / SIGN IN -->
                <Label Text="Remember Password?"
                       FontFamily="PlusJakartaSans"
                       FontSize="12"
                       TextColor="{StaticResource Gold}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0" />

                <Label Text="Sign In"
                       FontFamily="PlusJakartaSans"
                       FontSize="13"
                       TextColor="#C5A15B"
                       HorizontalOptions="Center"
                       Padding="0,2">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
