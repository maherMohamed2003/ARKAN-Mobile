<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ArkanMaui.Views.Auth.ResetPassword"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#2B2B2D"
    FlowDirection="LeftToRight">

    <ContentPage.Resources>

        <Color x:Key="ArkanRequired">#E53935</Color>
        <Color x:Key="ArkanWine">#6B1F38</Color>
        <LinearGradientBrush x:Key="FilledBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#D8B56A" Offset="0.0" />
            <GradientStop Color="#FFF4D6" Offset="0.5" />
            <GradientStop Color="#D8B56A" Offset="1.0" />
        </LinearGradientBrush>


        <SolidColorBrush x:Key="EmptyBrush" Color="#4A4A4A" />

        <Style x:Key="FormLabel"
               TargetType="Label"
               BasedOn="{StaticResource ArkanFieldLabel}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="HorizontalTextAlignment" Value="Start" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <Style x:Key="FormBorder"
               TargetType="Border"
               BasedOn="{StaticResource ArkanEntryBorder}">
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <Style x:Key="FormEntry" TargetType="Entry">
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="PlaceholderColor"
                    Value="{StaticResource ArkanPlaceholder}" />
            <Setter Property="TextColor"
                    Value="{StaticResource ArkanLight}" />
            <Setter Property="FontFamily" Value="JakartaRegular" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalTextAlignment" Value="Start" />
        </Style>

        <Style x:Key="FormIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="16" />
            <Setter Property="HeightRequest" Value="16" />
            <Setter Property="Aspect" Value="AspectFit" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

    </ContentPage.Resources>

    <Grid x:Name="RootGrid" BackgroundColor="#2B2B2D">

        <!-- BACKGROUND -->

        <Image Source="bg.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!-- <BoxView InputTransparent="True"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00201F22" Offset="0.0" />
                    <GradientStop Color="#00201F22" Offset="0.40" />
                    <GradientStop Color="#D9201F22" Offset="0.68" />
                    <GradientStop Color="#F2201F22" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView> -->

        <!-- MAIN CONTENT -->

        <ScrollView VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Spacing="16"
                Padding="20,4,20,35"
                VerticalOptions="Start">

                <!-- LOGO -->

                <Image
                    Source="logo.png"
                    HeightRequest="50"
                    Aspect="AspectFit"
                    HorizontalOptions="Center" />

                <!-- TITLE -->

                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label
                        Text="CREATE NEW PASSWORD"
                        FontFamily="CinzelRegular"
                        FontSize="25"
                        TextColor="#F3EBDD"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center" />
                    <BoxView
                        HeightRequest="1.5"
                        WidthRequest="85"
                        Color="#C9A55C"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Label
                    Text="Your code is verified, create new password"
                    FontFamily="JakartaRegular"
                    FontSize="13"
                    TextColor="#C9A55C"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />

                <!-- NEW PASSWORD -->

                <VerticalStackLayout Spacing="2">

                    <Label Style="{StaticResource FormLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                
                                <Span Text="New Password" />
                                <Span Text="*"
                                      TextColor="{StaticResource ArkanRequired}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Border Style="{StaticResource FormBorder}">
                        <Grid ColumnDefinitions="18,*,18" ColumnSpacing="4">
                            <Image Source="passlock.png"
                                   Style="{StaticResource FormIcon}" />

                            <Entry x:Name="NewPassword"
                                   Grid.Column="1"
                                   Placeholder="Enter New Password"
                                   IsPassword="True"
                                   Style="{StaticResource FormEntry}"
                                   TextChanged="OnPasswordTextChanged" />

                            <Image x:Name="EyeNew"
                                   Grid.Column="2"
                                   Source="lockedeye.png"
                                   Style="{StaticResource FormIcon}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleNewTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- CONFIRM NEW PASSWORD -->

                <VerticalStackLayout Spacing="2">

                    <Label Style="{StaticResource FormLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Confirm New Password" />
                                <Span Text="*"
                                      TextColor="{StaticResource ArkanRequired}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Border Style="{StaticResource FormBorder}">
                        <Grid ColumnDefinitions="18,*,18" ColumnSpacing="4">
                            <Image Source="passlock.png"
                                   Style="{StaticResource FormIcon}" />

                            <Entry x:Name="ConfirmPassword"
                                   Grid.Column="1"
                                   Placeholder="Confirm new password"
                                   IsPassword="True"
                                   Style="{StaticResource FormEntry}" />

                            <Image x:Name="EyeConfirm"
                                   Grid.Column="2"
                                   Source="lockedeye.png"
                                   Style="{StaticResource FormIcon}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleConfirmTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- PASSWORD STRENGTH -->

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Password Strength"
                               Style="{StaticResource FormLabel}" 
                               FontSize="14"/>
                        <Label x:Name="StrengthLabel"
                               Grid.Column="1"
                               Text=""
                               FontFamily="JakartaRegular"
                               FontSize="14"
                               TextColor="#C9A55C"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Border x:Name="Bar1" Grid.Column="0" HeightRequest="8" StrokeThickness="0"
            StrokeShape="RoundRectangle 4" Background="{StaticResource EmptyBrush}" />
                        <Border x:Name="Bar2" Grid.Column="1" HeightRequest="8" StrokeThickness="0"
            StrokeShape="RoundRectangle 4" Background="{StaticResource EmptyBrush}" />
                        <Border x:Name="Bar3" Grid.Column="2" HeightRequest="8" StrokeThickness="0"
            StrokeShape="RoundRectangle 4" Background="{StaticResource EmptyBrush}" />
                        <Border x:Name="Bar4" Grid.Column="3" HeightRequest="8" StrokeThickness="0"
            StrokeShape="RoundRectangle 4" Background="{StaticResource EmptyBrush}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- RESET BUTTON -->

                <Button
                    Text="RESET"
                    FontFamily="PlusJakartaSans"
                    Style="{StaticResource ArkanPrimaryButton}"
                    BackgroundColor="{StaticResource ArkanWine}"
                    TextColor="{StaticResource ArkanLight}"
                    BorderColor="{StaticResource ArkanSecondary}"
                    BorderWidth="1"
                    CornerRadius="20"
                    HeightRequest="40"
                    MinimumHeightRequest="0"
                    Padding="0"
                    FontSize="14"
                    Clicked="OnResetClicked" />

                <!-- BACK TO SIGN IN -->

                <HorizontalStackLayout HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,6,0,0"
                        Padding="0,4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="←"
            FontSize="14"
            TextColor="White"
            VerticalOptions="Center" />
                    <Label Text="Back to Sign In"
            FontFamily="PlusJakartaSans"
            FontSize="13"
            TextColor="#C5A15B"
            VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>