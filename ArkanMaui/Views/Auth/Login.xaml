<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#2B2B2D"
             FlowDirection="LeftToRight"
             x:Class="ArkanMaui.LoginPage.Login"
             Title="login">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Gold">#C9A55C</Color>
            <Color x:Key="Maroon">#6B1F37</Color>
            <Color x:Key="FieldBg">#26FFFFFF</Color>

            <x:String x:Key="TitleFont">CormorantRegular</x:String>
            <x:String x:Key="BodyFont">OutfitRegular</x:String>

            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource Gold}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="BackgroundColor" Value="{StaticResource FieldBg}" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>

            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="PlaceholderColor" Value="#9A9A9A" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#2B2B2D">

        <!-- BACKGROUND (full screen) -->
        <Image Source="bg.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />


        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,6,24,24" Spacing="6">

                <Image Source="logo1.png"
                       HeightRequest="50"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    
                    <Label 
                        Text="LOGIN"
                        FontFamily="CinzelRegular"
                        FontSize="25"
                        TextColor="#F3EBDD"
                        HorizontalOptions="Center" />
                    
                    <BoxView 
                        HeightRequest="1.5"
                        WidthRequest="85"
                        Color="{StaticResource Gold}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- User Name -->
                <VerticalStackLayout Spacing="3" Margin="0,4,0,0">
                    <Label 
                        Style="{StaticResource FieldLabel}" 
                        FontFamily="{StaticResource BodyFont}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="User Name" />
                                <Span Text="*" TextColor="Red" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    
                    <Border BackgroundColor="#2B2D2E" Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="6">
                            
                            <Image 
                                Source="person.png" 
                                WidthRequest="18" 
                                HeightRequest="18" 
                                VerticalOptions="Center" />
                            
                            <Entry 
                                x:Name="EmailEntry"
                                Grid.Column="1"
                                Placeholder="Enter your email"
                                Keyboard="Email"
                                Style="{StaticResource FieldEntry}" />
                        </Grid>
                        
                    </Border>
                    
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="3">
                    
                    <Label 
                        Style="{StaticResource FieldLabel}"
                        FontFamily="{StaticResource BodyFont}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Password" />
                                <Span Text="*" TextColor="Red" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    
                    
                    <Border 
                        BackgroundColor="#2B2D2E" Style="{StaticResource FieldBorder}">
                        <Grid 
                            ColumnDefinitions="22,*,24" ColumnSpacing="6">
                            <Image 
                                Source="passlock.png" 
                                WidthRequest="18" 
                                HeightRequest="18" 
                                VerticalOptions="Center" />
                            
                            
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="1"
                                   Placeholder="Enter your password"
                                   IsPassword="True"
                                   Style="{StaticResource FieldEntry}" />
                            
                            <Image x:Name="TogglePasswordButton"
                                   Grid.Column="2"
                                   Source="eye.png"
                                   Aspect="AspectFit"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTogglePasswordClicked" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border HeightRequest="40"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Margin="0,2,0,0">
                    <Border.Background>
                        
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C9A55C" Offset="0.0" />
                            <GradientStop Color="#E8D3A0" Offset="0.5" />
                            <GradientStop Color="#C9A55C"  Offset="1.0" />
                        </LinearGradientBrush>
                        
                    </Border.Background>
                    
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoogleTapped" />
                    </Border.GestureRecognizers>
                    
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Spacing="8">
                        
                        <Image 
                            Source="icon_google.png" 
                            WidthRequest="18" 
                            HeightRequest="18" />
                        
                        <Label 
                            Text="Continue With Google"
                            FontFamily="{StaticResource BodyFont}"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="{StaticResource Maroon}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border 
                    Style="{StaticResource FieldBorder}"
                    BackgroundColor="Transparent"
                    Padding="0">
                    
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGuestTapped" />
                    </Border.GestureRecognizers>
                    
                    <Label 
                        Text="Continue as a Guest"
                        FontFamily="{StaticResource BodyFont}"
                        FontSize="13"
                        TextColor="{StaticResource Gold}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" VerticalOptions="Center">

                    
                    <Grid Grid.Column="0"
                          WidthRequest="30"
                          HeightRequest="30"
                          VerticalOptions="Center">
                        
                        
                        <Border WidthRequest="18"
                                HeightRequest="18"
                                StrokeShape="RoundRectangle 4"
                                Stroke="{StaticResource Gold}"
                                StrokeThickness="1.2"
                                BackgroundColor="#2B2D2E"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                InputTransparent="True" />
                        
                        
                        <Path Data="M1,5 L4.5,8.5 L11,1"
                              Stroke="{StaticResource Gold}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              Aspect="Uniform"
                              WidthRequest="11"
                              HeightRequest="9"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True"
                              IsVisible="{Binding IsChecked, Source={x:Reference RememberCheck}}" />
                        <CheckBox x:Name="RememberCheck"
                                  IsChecked="True"
                                  Opacity="0" />
                    </Grid>

                    <Label Grid.Column="1"
                           Text="Remember me"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="12"
                           TextColor="White"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="Forgot Password ?"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="12"
                           TextColor="{StaticResource Gold}"
                           TextDecorations="Underline"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Button Text="LOGIN"
                        FontFamily="PlusJakartaSans"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        BackgroundColor="{StaticResource Maroon}"
                        BorderColor="{StaticResource Gold}"
                        BorderWidth="1"
                        CornerRadius="21"
                        HeightRequest="42"
                        MinimumHeightRequest="0"
                        Padding="0"
                        Clicked="OnLoginClicked" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <BoxView WidthRequest="30" HeightRequest="1" Color="{StaticResource Gold}" VerticalOptions="Center" />
                    <Label Text="or"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="12"
                           TextColor="{StaticResource Gold}" />
                    <BoxView WidthRequest="30" HeightRequest="1" Color="{StaticResource Gold}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Don't have an account ?"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="12"
                           TextColor="{StaticResource Gold}"
                           TextDecorations="Underline"
                           HorizontalOptions="Center" />
                    
                    
                    <Label Text="Sign Up"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="14"
                           TextColor="#C5A15B"
                           HorizontalOptions="Center"
                           Padding="0,2">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSignUpTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
