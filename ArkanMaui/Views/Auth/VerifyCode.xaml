<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#2B2B2D"
             FlowDirection="LeftToRight"
             x:Class="ArkanMaui.Views.Auth.VerifyCode"
             Title="verify code">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Gold">#C9A55C</Color>
            <Color x:Key="Maroon">#6B1F37</Color>

            <x:String x:Key="TitleFont">CormorantRegular</x:String>
            <x:String x:Key="BodyFont">OutfitRegular</x:String>

            <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#C5A15B" Offset="0.0" />
                <GradientStop Color="#FFFFFF" Offset="0.5" />
                <GradientStop Color="#C5A15B" Offset="1.0" />
            </LinearGradientBrush>


            <!-- مربع الكود -->
            <Style x:Key="CodeBox" TargetType="Border">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="Stroke" Value="{StaticResource GoldGradient}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="#2B2D2E" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>
            

            <!-- الرقم جوه المربع -->
            <Style x:Key="CodeDigit" TargetType="Label">
                <Setter Property="FontFamily" Value="OutfitRegular" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#2B2B2D">

        <!-- BACKGROUND (full screen) -->
        <Image Source="bg.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />


        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,6,24,24" Spacing="6">

                <!-- LOGO -->
                <Image Source="logo1.png"
                       HeightRequest="50"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />
                

                
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    
                    <Label 
                        Text="VERIFY CODE"
                        FontFamily="CinzelRegular"
                        FontSize="25"
                        TextColor="#F3EBDD"
                        HorizontalOptions="Center" />
                    
                    <BoxView 
                        HeightRequest="1.5"
                        WidthRequest="85"
                        Color="{StaticResource Gold}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                

                <!-- DESCRIPTION --> 
                <Label 
                    x:Name="DescriptionLabel"
                    Text="Enter the digit code sent to your ."
                    FontFamily="PlusJakartaSans"
                    FontSize="13"
                    TextColor="{StaticResource Gold}"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center"
                    Margin="0,10,0,6" />

                <!-- CODE BOXES -->
                <Grid HorizontalOptions="Center" HeightRequest="48">

                    <HorizontalStackLayout Spacing="10">

                        <Border 
                            x:Name="Box1" 
                            Style="{StaticResource CodeBox}">
                            
                            <Label 
                                x:Name="Digit1" 
                                Style="{StaticResource CodeDigit}" />
                        </Border>
                        
                        
                        <Border 
                            x:Name="Box2" 
                            Style="{StaticResource CodeBox}">

                            <Label 
                                x:Name="Digit2" 
                                Style="{StaticResource CodeDigit}" />
                        </Border>
                        
                        
                        <Border 
                            x:Name="Box3" 
                            Style="{StaticResource CodeBox}">

                            <Label 
                                x:Name="Digit3" 
                                Style="{StaticResource CodeDigit}" />
                        </Border>
                        
                        
                        <Border 
                            x:Name="Box4" 
                            Style="{StaticResource CodeBox}">
                            
                            <Label 
                                x:Name="Digit4" 
                                Style="{StaticResource CodeDigit}" />
                        </Border>
                        
                        
                        <Border 
                            x:Name="Box5" 
                            Style="{StaticResource CodeBox}">
                            <Label 
                                x:Name="Digit5" 
                                Style="{StaticResource CodeDigit}" />
                        </Border>
                        <Border 
                            x:Name="Box6" 
                            Style="{StaticResource CodeBox}">
                            <Label 
                                x:Name="Digit6" 
                                Style="{StaticResource CodeDigit}" />
                        </Border>

                    </HorizontalStackLayout>

                    
                    <Entry x:Name="CodeEntry"
                           Opacity="0"
                           MaxLength="6"
                           Keyboard="Numeric"
                           IsTextPredictionEnabled="False"
                           BackgroundColor="Transparent"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           TextChanged="OnCodeTextChanged" />
                </Grid>

                <!-- TIMER + RESEND -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,8,0,4">

                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="6"
                                           VerticalOptions="Center">
                        
                        <Image Source="icon_timer.png"
                               WidthRequest="16"
                               HeightRequest="16"
                               Aspect="AspectFit"
                               VerticalOptions="Center" />
                        <Label x:Name="TimerLabel"
                               Text="02:45"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label x:Name="ResendLabel"
                           Grid.Column="1"
                           Text="Resend code"
                           FontFamily="PlusJakartaSans"
                           FontSize="12"
                           TextColor="#C5A15B"
                           TextDecorations="Underline"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResendTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- CONTINUE BUTTON -->
                <Button Text="CONTINUE"
                        FontFamily="PlusJakartaSans"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        BackgroundColor="{StaticResource Maroon}"
                        BorderColor="{StaticResource Gold}"
                        BorderWidth="1"
                        CornerRadius="21"
                        HeightRequest="42"
                        MinimumHeightRequest="0"
                        Padding="0"
                        Margin="0,4,0,0"
                        Clicked="OnContinueClicked" />

                <!-- BACK -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="6"
                                       Margin="0,6,0,0"
                                       Padding="0,4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="←"
                           FontSize="14"
                           TextColor="White"
                           VerticalOptions="Center" />
                    <Label Text="Back"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="13"
                           TextColor="{StaticResource Gold}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
